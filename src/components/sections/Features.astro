---
interface Feature {
  title: string
  icon?: string
  description: string
}

interface Props {
  features: Feature[]
  heading?: string
  subheading?: string
}

const { features, heading = 'Celebrating Your Vision With Artistic Experience', subheading = 'Narua is dedicated in handling you design needs so you can focus on building.' } = Astro.props
---

<section id="features" class="py-12 sm:py-18">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">{heading}</h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">{subheading}</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map(feature => (
        <div class="relative p-6 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow">
          {feature.icon && (
            <div class="text-3xl mb-4"><h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">{feature.icon}<span class="px-2">{feature.title}</span></h3></div>
          )}
          <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
