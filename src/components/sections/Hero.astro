---
interface Props {
  headline: string
  subheadline: string
  ctaPrimary: string
  ctaPrimaryHref: string
  ctaSecondary?: string
  ctaSecondaryHref?: string
}

const { headline, subheadline, ctaPrimary, ctaPrimaryHref, ctaSecondary, ctaSecondaryHref } = Astro.props
---

<style>
  .narua-heading {
    color: white;
    -webkit-text-stroke: 2px black;
    paint-order: stroke fill;
  }

  .hero-pride-bg {
    /* 12 original stripes repeated 4× = 48 layers */
    background-image:
      /* cycle 1 */
      linear-gradient(to bottom, #807E7C, #938F85),
      linear-gradient(to bottom, #746E6C, #857D75),
      linear-gradient(to bottom, #6A6462, #7A706A),
      linear-gradient(to bottom, #666262, #746A68),
      linear-gradient(to bottom, #606060, #6E6462),
      linear-gradient(to bottom, #5C5858, #6A6260),
      linear-gradient(to bottom, #585252, #72605A),
      linear-gradient(to bottom, #5C5050, #8C6C66),
      linear-gradient(to bottom, #6A5856, #A47E78),
      linear-gradient(to bottom, #7E6462, #BC9288),
      linear-gradient(to bottom, #9A7872, #D0AC9E),
      linear-gradient(to bottom, #BA9688, #E8C8B0),
      /* cycle 2 */
      linear-gradient(to bottom, #807E7C, #938F85),
      linear-gradient(to bottom, #746E6C, #857D75),
      linear-gradient(to bottom, #6A6462, #7A706A),
      linear-gradient(to bottom, #666262, #746A68),
      linear-gradient(to bottom, #606060, #6E6462),
      linear-gradient(to bottom, #5C5858, #6A6260),
      linear-gradient(to bottom, #585252, #72605A),
      linear-gradient(to bottom, #5C5050, #8C6C66),
      linear-gradient(to bottom, #6A5856, #A47E78),
      linear-gradient(to bottom, #7E6462, #BC9288),
      linear-gradient(to bottom, #9A7872, #D0AC9E),
      linear-gradient(to bottom, #BA9688, #E8C8B0),
      /* cycle 3 */
      linear-gradient(to bottom, #807E7C, #938F85),
      linear-gradient(to bottom, #746E6C, #857D75),
      linear-gradient(to bottom, #6A6462, #7A706A),
      linear-gradient(to bottom, #666262, #746A68),
      linear-gradient(to bottom, #606060, #6E6462),
      linear-gradient(to bottom, #5C5858, #6A6260),
      linear-gradient(to bottom, #585252, #72605A),
      linear-gradient(to bottom, #5C5050, #8C6C66),
      linear-gradient(to bottom, #6A5856, #A47E78),
      linear-gradient(to bottom, #7E6462, #BC9288),
      linear-gradient(to bottom, #9A7872, #D0AC9E),
      linear-gradient(to bottom, #BA9688, #E8C8B0),
      /* cycle 4 */
      linear-gradient(to bottom, #807E7C, #938F85),
      linear-gradient(to bottom, #746E6C, #857D75),
      linear-gradient(to bottom, #6A6462, #7A706A),
      linear-gradient(to bottom, #666262, #746A68),
      linear-gradient(to bottom, #606060, #6E6462),
      linear-gradient(to bottom, #5C5858, #6A6260),
      linear-gradient(to bottom, #585252, #72605A),
      linear-gradient(to bottom, #5C5050, #8C6C66),
      linear-gradient(to bottom, #6A5856, #A47E78),
      linear-gradient(to bottom, #7E6462, #BC9288),
      linear-gradient(to bottom, #9A7872, #D0AC9E),
      linear-gradient(to bottom, #BA9688, #E8C8B0);
    background-size: calc(100% / 48) 100%;
    background-repeat: no-repeat;
    background-position:
      calc(0  * 100% / 47) 0%, calc(1  * 100% / 47) 0%,
      calc(2  * 100% / 47) 0%, calc(3  * 100% / 47) 0%,
      calc(4  * 100% / 47) 0%, calc(5  * 100% / 47) 0%,
      calc(6  * 100% / 47) 0%, calc(7  * 100% / 47) 0%,
      calc(8  * 100% / 47) 0%, calc(9  * 100% / 47) 0%,
      calc(10 * 100% / 47) 0%, calc(11 * 100% / 47) 0%,
      calc(12 * 100% / 47) 0%, calc(13 * 100% / 47) 0%,
      calc(14 * 100% / 47) 0%, calc(15 * 100% / 47) 0%,
      calc(16 * 100% / 47) 0%, calc(17 * 100% / 47) 0%,
      calc(18 * 100% / 47) 0%, calc(19 * 100% / 47) 0%,
      calc(20 * 100% / 47) 0%, calc(21 * 100% / 47) 0%,
      calc(22 * 100% / 47) 0%, calc(23 * 100% / 47) 0%,
      calc(24 * 100% / 47) 0%, calc(25 * 100% / 47) 0%,
      calc(26 * 100% / 47) 0%, calc(27 * 100% / 47) 0%,
      calc(28 * 100% / 47) 0%, calc(29 * 100% / 47) 0%,
      calc(30 * 100% / 47) 0%, calc(31 * 100% / 47) 0%,
      calc(32 * 100% / 47) 0%, calc(33 * 100% / 47) 0%,
      calc(34 * 100% / 47) 0%, calc(35 * 100% / 47) 0%,
      calc(36 * 100% / 47) 0%, calc(37 * 100% / 47) 0%,
      calc(38 * 100% / 47) 0%, calc(39 * 100% / 47) 0%,
      calc(40 * 100% / 47) 0%, calc(41 * 100% / 47) 0%,
      calc(42 * 100% / 47) 0%, calc(43 * 100% / 47) 0%,
      calc(44 * 100% / 47) 0%, calc(45 * 100% / 47) 0%,
      calc(46 * 100% / 47) 0%, calc(47 * 100% / 47) 0%;
    filter: blur(5px);
  }
</style>

<section class="relative py-6 sm:py-10 overflow-hidden">
  <!-- Blurred stripe background — extends past edges to prevent blur fade -->
  <div class="absolute -z-10 hero-pride-bg" style="inset: -8%;"></div>
  <!-- Subtle vignette overlay -->
  <div class="absolute inset-0 -z-10" style="background: radial-gradient(ellipse at center, transparent 40%, rgba(30,20,18,0.22) 100%);"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="hidden sm:mb-8 sm:flex sm:justify-center gap-4">
      <div class="flex flex-row rounded-full px-3 py-1 text-sm/6 text-stone-800 ring-1 ring-white/40 hover:ring-white/70 bg-white/10 backdrop-blur-sm items-center justify-center">
        Subscribe Now. <a href="#" class="font-semibold text-stone-900"><span aria-hidden="true" class="absolute inset-0"></span>Pause or Cancel Anytime <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="flex flex-row flex-nowrap items-center justify-center gap-4 rounded-full border border-stone-900/10 bg-white/60 py-2 pl-2 pr-3 shadow-md backdrop-blur-sm">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-500 text-white">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
            <path fill-rule="evenodd" d="M1.5 4.5a3 3 0 0 1 3-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 0 1-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 0 0 6.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 0 1 1.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 0 1-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5Z" clip-rule="evenodd" />
          </svg>
        </span>
        <span class="whitespace-nowrap pl-1 text-base font-medium text-stone-900">Book a 15-min intro call</span>
        <a
          href="/#contact"
          class="inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-stone-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-stone-800"
        >
          Book a call
        </a>
      </div>
    </div>
    <div class="flex items-center justify-center gap-3 max-w-3xl mx-auto">
      <p class="text-3xl sm:text-3xl lg:text-5xl font-medium tracking-tight text-white drop-shadow-sm">
        {headline}
      </p>
      <img src="/favicon.svg" alt="Narua logo" class="h-8 sm:h-10 lg:h-12 w-auto drop-shadow-sm" />
    </div>

    <p class="mt-6 text-lg sm:text-3xl font-medium max-w-4xl mx-auto font-serif text-white">
      {subheadline}
    </p>
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={ctaPrimaryHref}
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-stone-800 rounded-xl hover:bg-stone-900 transition-colors shadow-md"
      >
        {ctaPrimary}
      </a>
      {ctaSecondary && ctaSecondaryHref && (
        <a
          href={ctaSecondaryHref}
          class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base font-medium text-stone-900 bg-white/50 border border-stone-900/20 rounded-xl hover:bg-white/70 backdrop-blur-sm transition-colors"
        >
          {ctaSecondary}
        </a>
      )}
    </div>
  </div>
</section>
