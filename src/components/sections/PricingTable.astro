---
import { pricingTiers } from '../../content/config/pricing'
---

<section id="pricing" class="py-20 sm:py-28 bg-gray-50 dark:bg-gray-800/50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">Simple, transparent pricing</h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Start free, upgrade as you grow. No hidden fees.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      {pricingTiers.map(tier => (
        <div class={`relative p-8 rounded-2xl border ${tier.highlighted ? 'bg-brand-600 border-brand-600 shadow-xl text-white' : 'bg-white dark:bg-gray-800 border-gray-100 dark:border-gray-700 shadow-sm'}`}>
          {tier.highlighted && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="bg-amber-400 text-amber-900 text-xs font-semibold px-3 py-1 rounded-full">Most popular</span>
            </div>
          )}
          <div class="mb-6">
            <h3 class={`text-lg font-semibold ${tier.highlighted ? 'text-white' : 'text-gray-900 dark:text-gray-100'}`}>{tier.name}</h3>
            <div class="mt-2 flex items-baseline gap-1">
              <span class={`text-4xl font-bold ${tier.highlighted ? 'text-white' : 'text-gray-900 dark:text-gray-100'}`}>
                {tier.price === 0 ? 'Free' : `$${tier.price}`}
              </span>
              {tier.price > 0 && (
                <span class={`text-sm ${tier.highlighted ? 'text-brand-100' : 'text-gray-500 dark:text-gray-400'}`}>/{tier.period}</span>
              )}
            </div>
            <p class={`mt-2 text-sm ${tier.highlighted ? 'text-brand-100' : 'text-gray-500 dark:text-gray-400'}`}>{tier.description}</p>
          </div>

          <ul class="space-y-3 mb-8">
            {tier.features.map(feature => (
              <li class="flex items-start gap-2">
                <svg class={`w-5 h-5 mt-0.5 shrink-0 ${tier.highlighted ? 'text-brand-200' : 'text-brand-500'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class={`text-sm ${tier.highlighted ? 'text-brand-100' : 'text-gray-600 dark:text-gray-300'}`}>{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={tier.href}
            class={`block w-full text-center px-4 py-3 text-sm font-medium rounded-xl transition-colors ${
              tier.highlighted
                ? 'bg-white text-brand-700 hover:bg-brand-50'
                : 'bg-brand-600 text-white hover:bg-brand-700'
            }`}
          >
            {tier.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
