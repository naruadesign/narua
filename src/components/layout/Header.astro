---
import { siteConfig } from '../../content/config/site'
import { navLinks } from '../../content/config/navigation'

const currentPath = Astro.url.pathname
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 font-semibold text-gray-900 hover:text-brand-600 transition-colors">
        <img src="/narua64x64.png" alt={siteConfig.name} class="w-8 h-8 rounded" />
        {siteConfig.name}
      </a>

      <nav class="hidden md:flex items-center gap-6">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors hover:text-brand-600 ${
              currentPath === link.href ? 'text-brand-600' : 'text-gray-600'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="/contact"
          class="hidden sm:inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700 transition-colors"
        >
          Get started
        </a>

        <button
          id="menu-toggle"
          class="md:hidden p-2 rounded-md text-gray-600 hover:text-gray-900 hover:bg-gray-100"
          aria-label="Toggle menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-3">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`text-sm font-medium transition-colors hover:text-brand-600 ${
            currentPath === link.href ? 'text-brand-600' : 'text-gray-600'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contact"
        class="mt-2 inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-brand-600 rounded-lg hover:bg-brand-700 transition-colors"
      >
        Get started
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')
  const menu = document.getElementById('mobile-menu')
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'))
</script>
