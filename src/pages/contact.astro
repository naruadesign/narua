---
import { getEntry, render } from 'astro:content'
import BaseLayout from '../components/layout/BaseLayout.astro'
import ContactForm from '../components/sections/ContactForm.astro'

const entry = await getEntry('pages', 'contact')
if (!entry) throw new Error('Missing content: src/content/pages/contact.mdx')

const { Content } = await render(entry)
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pt-20">
    <div class="prose prose-gray prose-lg max-w-none">
      <Content />
    </div>
  </div>
  <ContactForm />
</BaseLayout>
