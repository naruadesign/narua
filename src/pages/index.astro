---
import { getEntry, render } from 'astro:content'
import BaseLayout from '../components/layout/BaseLayout.astro'
import Hero from '../components/sections/Hero.astro'
import Features from '../components/sections/Features.astro'
import PricingTable from '../components/sections/PricingTable.astro'
import ContactForm from '../components/sections/ContactForm.astro'

const home = await getEntry('pages', 'home')
const about = await getEntry('pages', 'about')

if (!home) throw new Error('Missing content: src/content/pages/home.mdx')
if (!about) throw new Error('Missing content: src/content/pages/about.mdx')

const { Content: AboutContent } = await render(about)
const { hero, features } = home.data
---

<BaseLayout title="Home" description={home.data.description}>
  {hero && (
    <Hero
      headline={hero.headline}
      subheadline={hero.subheadline}
      ctaPrimary={hero.ctaPrimary}
      ctaPrimaryHref={hero.ctaPrimaryHref}
      ctaSecondary={hero.ctaSecondary}
      ctaSecondaryHref={hero.ctaSecondaryHref}
    />
  )}

  {features && <Features features={features} />}

  <section id="about" class="py-20 sm:py-28 bg-gray-50 dark:bg-gray-800/50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-gray prose-lg dark:prose-invert max-w-none">
        <AboutContent />
      </div>
    </div>
  </section>

  <PricingTable />

  <div>
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-28 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">Get in Touch</h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">Have a question or want to learn more? We'd love to hear from you.</p>
    </div>
    <ContactForm />
  </div>
</BaseLayout>
